# Copy to .env and adjust. Loaded from backend/ when the app starts.

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Primary: full SQLAlchemy URL (matches app config field database_url → env DATABASE_URL)
# If set, used as the SQLAlchemy URL and POSTGRES_* below are ignored for the URL.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ktzh_digital_twin

# If DATABASE_URL is empty, these are used (POSTGRES_*):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ktzh_digital_twin

# -----------------------------------------------------------------------------
# Frontend origins allowed to call API with credentials (comma-separated)
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Auth session cookie
# -----------------------------------------------------------------------------
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=session
SESSION_COOKIE_PATH=/
# Leave unset or empty for host-only cookies in dev
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
# lax | strict | none
SESSION_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Simulator ingest → DB + WebSocket fan-out
# -----------------------------------------------------------------------------
SIMULATOR_INGEST_ENABLED=true
SIMULATOR_WS_URL=ws://127.0.0.1:9001/telemetry
SIMULATOR_RECONNECT_DELAY_SEC=3
TELEMETRY_SNAPSHOT_INTERVAL_SEC=1